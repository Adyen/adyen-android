<network-security-config>
    <!--
      The instrumented tests serve their mock backend over HTTP on loopback, which the platform blocks by default.
      Only loopback is allowed, and only in debug builds, so no real traffic can be sent over cleartext.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
