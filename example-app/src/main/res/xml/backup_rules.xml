<full-backup-content>
    <!--
      Applies below Android 12, where data_extraction_rules.xml is ignored. Backups are already switched off through
      android:allowBackup="false", so this only makes the intent explicit for both eras. The domains match
      data_extraction_rules.xml.
    -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
